# Kakao REST API key for walking routes. This is NOT the JavaScript map key.
# Server only: never put this value in VITE_* or the app bundle.
KAKAO_REST_API_KEY=
# Server only. Never put the OpenAI key in VITE_* variables.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
FIREBASE_PROJECT_ID=
PORT=8787
HOST=127.0.0.1
# Web origins and Capacitor Android's origin. Use exact production origins.
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:8443,https://localhost
