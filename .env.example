# Copy to .env.local and replace with the Web App configuration from Firebase Console.
# These are browser-visible identifiers, NOT Admin SDK credentials.
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_USE_FIREBASE_EMULATORS=false

# Spark plan: account deletion uses the client SDK.

# Kakao Developers JavaScript key (browser-visible; restrict allowed domains).
VITE_KAKAO_MAP_APP_KEY=

# Full HTTPS endpoint for the routing server (required for Android/production).
# Local Vite development proxies /api/walking-route to 127.0.0.1:8787.
VITE_ROUTING_API_URL=
# Optional full HTTPS endpoint for production / Android (local Vite uses a proxy).
VITE_CHAT_API_URL=
