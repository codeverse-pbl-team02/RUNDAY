{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "dev:local": "vite --host localhost --port 5174 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:maps": "node --test scripts/kakao-map.test.mjs",
    "test:navigation": "node --test scripts/back-navigation.test.mjs",
    "test:routes": "node --test scripts/course-route.test.mjs",
    "test:courses": "node --test scripts/course-catalog.test.mjs",
    "test:service-area": "node --test scripts/service-area.test.mjs",
    "test:routing": "node --test scripts/walking-route.test.mjs server/test/*.test.mjs",
    "routing:server": "npm --prefix server start",
    "chat:knowledge": "node scripts/build-chat-knowledge.mjs",
    "test:chat": "node --test server/test/chat.test.mjs scripts/chat-recommendation.test.mjs",
    "firebase:check": "node scripts/check-firebase-config.mjs",
    "android:sync": "cap sync android",
    "android:bundle": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "test:native": "node --experimental-vm-modules --test scripts/native-location.test.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "8.5.2",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "8.2.4",
    "firebase": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
