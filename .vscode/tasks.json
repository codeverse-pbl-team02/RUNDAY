{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Runday: 개발 서버",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "dev:local"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^(?!)$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:.*http"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Runday: 빌드",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
